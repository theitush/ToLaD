{
  "name": "@tolad/procgen",
  "version": "0.1.0",
  "description": "Deterministic, stateless procedural individuals for ToLaD: integer hash, Feistel IDs, binomial-split pedigree.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "bench": "node bench/pedigree.bench.ts",
    "golden:update": "node scripts/make-golden.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
